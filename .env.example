# Copy to .env.compose for Docker Compose development and fill in both secrets.
# Generate separate random values for these two settings.
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=

POSTGRES_DB=findash
POSTGRES_USER=findash
BACKEND_PORT=8000
FRONTEND_PORT=5173
API_KEY=

# Optional background checks
NOTIFICATION_MARKET_CHECKS_ENABLED=false
NOTIFICATION_RENEWAL_INTERVAL_SECONDS=3600
NOTIFICATION_BUDGET_INTERVAL_SECONDS=900
NOTIFICATION_MARKET_INTERVAL_SECONDS=900
NOTIFICATION_GROCERY_INTERVAL_SECONDS=900
NOTIFICATION_RETENTION_INTERVAL_SECONDS=86400
NOTIFICATION_RETENTION_DAYS=90
WARRANTY_PROOF_RETENTION_DAYS=365
WARRANTY_RECORD_RETENTION_DAYS=0

# Production uses an external secret store or an ignored environment file.
# DJANGO_ENV=production
# DJANGO_ALLOWED_HOSTS=fin.example.com
# DJANGO_TRUST_PROXY_HEADERS=true
# DJANGO_CORS_ALLOWED_ORIGINS=
# DJANGO_CSRF_TRUSTED_ORIGINS=
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=5432
# DB_SSLMODE=verify-full
# DB_SSLROOTCERT=/path/to/database-ca.pem
# CELERY_BROKER_URL=
# DJANGO_THROTTLE_CACHE_URL=
# DJANGO_THROTTLE_NUM_PROXIES=0
