map "$status:$uri" $findash_cache_control {
    ~^[23][0-9][0-9]:/assets/ "public, max-age=31536000, immutable";
    ~^[0-9]+:/(api|api-auth|admin)(/|$) "no-store";
    ~^[0-9]+:/index[.]html$ "no-cache";
    default "";
}

map $uri $findash_csp {
    ~^/(admin|api-auth)(/|$) "frame-ancestors 'none'; base-uri 'self'; object-src 'none'";
    default "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data: blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'";
}

log_format findash '$request_method $uri $status $request_time';

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    access_log /var/log/nginx/access.log findash;
    client_max_body_size 12m;

    add_header Cache-Control $findash_cache_control always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header X-Frame-Options DENY always;
    add_header Content-Security-Policy $findash_csp always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    location = /healthz/ {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location ~ ^/(api|api-auth|admin|static)(/|$) {
        resolver ${FINDASH_DNS_RESOLVER} valid=30s;
        resolver_timeout 5s;
        set $findash_backend ${FINDASH_BACKEND_UPSTREAM};
        proxy_pass http://$findash_backend;
        proxy_set_header Host $http_host;
        # The private Nginx service receives this from the trusted TLS edge.
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-For $http_x_forwarded_for;
        proxy_read_timeout 125s;
    }

    location /assets/ {
        try_files $uri =404;
    }

    location / {
        try_files $uri /index.html;
    }
}
